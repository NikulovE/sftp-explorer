<UserControl
    x:Class="SftpExplorerWinUI.Controls.ConnectionProtocolReveal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">

    <UserControl.Resources>
        <Style x:Key="ProtocolHitTargetStyle" TargetType="Button">
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Background" Value="#01000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RevealRoot"
          Background="Transparent"
          PointerMoved="RevealRoot_PointerMoved"
          PointerExited="RevealRoot_PointerExited">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ProtocolStates">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="{StaticResource ControlFastAnimationDuration}">
                        <VisualTransition.GeneratedEasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </VisualTransition.GeneratedEasingFunction>
                    </VisualTransition>
                    <VisualTransition From="Sftp"
                                      To="Ssh"
                                      GeneratedDuration="0:0:0.333">
                        <VisualTransition.GeneratedEasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </VisualTransition.GeneratedEasingFunction>
                    </VisualTransition>
                    <VisualTransition From="Ssh"
                                      To="Sftp"
                                      GeneratedDuration="0:0:0.333">
                        <VisualTransition.GeneratedEasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </VisualTransition.GeneratedEasingFunction>
                    </VisualTransition>
                </VisualStateGroup.Transitions>

                <VisualState x:Name="Normal">
                    <VisualState.Setters>
                        <Setter Target="BlurLayer.Opacity" Value="0"/>
                        <Setter Target="BlurVeil.Opacity" Value="0"/>
                        <Setter Target="AccentWash.Opacity" Value="0"/>
                        <Setter Target="SftpLabel.Opacity" Value="0"/>
                        <Setter Target="SftpTranslate.X" Value="40"/>
                        <Setter Target="SshLabel.Opacity" Value="0"/>
                        <Setter Target="SshTranslate.X" Value="-40"/>
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Sftp">
                    <VisualState.Setters>
                        <Setter Target="BlurLayer.Opacity" Value="0.96"/>
                        <Setter Target="BlurVeil.Opacity" Value="0.20"/>
                        <Setter Target="AccentWash.Opacity" Value="0.035"/>
                        <Setter Target="SftpLabel.Opacity" Value="1"/>
                        <Setter Target="SftpTranslate.X" Value="0"/>
                        <Setter Target="SshLabel.Opacity" Value="0"/>
                        <Setter Target="SshTranslate.X" Value="-40"/>
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Ssh">
                    <VisualState.Setters>
                        <Setter Target="BlurLayer.Opacity" Value="0.96"/>
                        <Setter Target="BlurVeil.Opacity" Value="0.20"/>
                        <Setter Target="AccentWash.Opacity" Value="0.035"/>
                        <Setter Target="SftpLabel.Opacity" Value="0"/>
                        <Setter Target="SftpTranslate.X" Value="40"/>
                        <Setter Target="SshLabel.Opacity" Value="1"/>
                        <Setter Target="SshTranslate.X" Value="0"/>
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Touch">
                    <VisualState.Setters>
                        <Setter Target="BlurLayer.Opacity" Value="0.96"/>
                        <Setter Target="BlurVeil.Opacity" Value="0.20"/>
                        <Setter Target="AccentWash.Opacity" Value="0.035"/>
                        <Setter Target="SftpLabel.Opacity" Value="1"/>
                        <Setter Target="SftpTranslate.X" Value="0"/>
                        <Setter Target="SshLabel.Opacity" Value="1"/>
                        <Setter Target="SshTranslate.X" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Border x:Name="BlurLayer"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                CornerRadius="7"
                IsHitTestVisible="False"
                Opacity="0"/>

        <Border x:Name="BlurVeil"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="7"
                IsHitTestVisible="False"
                Opacity="0"/>

        <Border x:Name="AccentWash"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="7"
                IsHitTestVisible="False"
                Opacity="0"/>

        <Grid x:Name="WaveLayer"
              Width="96"
              HorizontalAlignment="Center"
              IsHitTestVisible="False"
              Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="WaveTranslate" X="0"/>
            </Grid.RenderTransform>
            <Grid RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <SkewTransform AngleX="-10"/>
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="12"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        Opacity="0.08"/>
                <Border Grid.Column="1"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        Opacity="0.24"/>
                <Border Grid.Column="2"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        Opacity="0.55"/>
                <Border Grid.Column="3"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        Opacity="0.24"/>
                <Border Grid.Column="4"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        Opacity="0.08"/>
            </Grid>
        </Grid>

        <Grid IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SftpLabel"
                       Grid.Column="0"
                       Text="SFTP"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="16"
                       FontWeight="SemiBold"
                       CharacterSpacing="80"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       Opacity="0">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="SftpTranslate" X="40"/>
                </TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock x:Name="SshLabel"
                       Grid.Column="1"
                       Text="SSH"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="16"
                       FontWeight="SemiBold"
                       CharacterSpacing="80"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       Opacity="0">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="SshTranslate" X="-40"/>
                </TextBlock.RenderTransform>
            </TextBlock>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="SftpButton"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Style="{StaticResource ProtocolHitTargetStyle}"
                    CornerRadius="7,0,0,7"
                    Click="SftpButton_Click"
                    PointerEntered="SftpButton_PointerEntered"
                    PointerPressed="SftpButton_PointerPressed"
                    GotFocus="SftpButton_GotFocus"
                    LostFocus="ProtocolButton_LostFocus"/>
            <Button x:Name="SshButton"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Style="{StaticResource ProtocolHitTargetStyle}"
                    CornerRadius="0,7,7,0"
                    Click="SshButton_Click"
                    PointerEntered="SshButton_PointerEntered"
                    PointerPressed="SshButton_PointerPressed"
                    GotFocus="SshButton_GotFocus"
                    LostFocus="ProtocolButton_LostFocus"/>
        </Grid>
    </Grid>
</UserControl>
