<Window
    x:Class="SftpExplorerWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Standard WinUI TitleBar shown before a connection is opened. -->
        <TitleBar Grid.Row="0"
                  x:Name="WindowTitleBar"
                  AutoRefreshDragRegions="True">
            <TitleBar.LeftHeader>
                <Grid x:Name="SimpleTitleBar"
                      MinHeight="32"
                      Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE753;"
                              FontSize="16"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="12,8"/>

                    <TextBlock Grid.Column="1"
                               x:Uid="AppTitle"
                               VerticalAlignment="Center"
                               Margin="8,0"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               FontWeight="SemiBold"/>
                </Grid>
            </TitleBar.LeftHeader>
        </TitleBar>

        <!-- WinUI document-tab pattern: the TabView itself occupies the title bar. -->
        <Grid Grid.Row="0" x:Name="TitleBarArea" Visibility="Collapsed">
            <TabView x:Name="MainTabView"
                     VerticalAlignment="Stretch"
                     IsAddTabButtonVisible="True"
                     TabWidthMode="Equal"
                     CanDragTabs="True"
                     CanReorderTabs="True"
                     AddTabButtonClick="MainTabView_AddTabButtonClick"
                     TabCloseRequested="MainTabView_TabCloseRequested">
                <TabView.TabStripHeader>
                    <Button x:Name="TogglePaneButton"
                            Click="TogglePaneButton_Click"
                            Width="40"
                            Height="32"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="Toggle connections panel">
                        <FontIcon Glyph="&#xE700;" FontSize="14"/>
                    </Button>
                </TabView.TabStripHeader>
                <TabView.TabStripFooter>
                    <!-- Keep an input-free area for moving the window. -->
                    <Grid x:Name="CustomDragRegion"
                          MinWidth="188"
                          Background="Transparent"/>
                </TabView.TabStripFooter>
            </TabView>
        </Grid>

        <!-- Startup Panel (shown by default) -->
        <Grid Grid.Row="1" x:Name="StartupPanel" Visibility="Visible">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Connections Panel -->
            <Border Grid.Column="0" 
                   BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                   BorderThickness="0,0,1,0">
                <!-- ConnectionsPanel будет добавлен в code-behind -->
            </Border>

            <!-- Right: Welcome Area -->
            <Grid Grid.Column="1">
                <StackPanel HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           Spacing="24"
                           MaxWidth="400">
                    <FontIcon Glyph="&#xE968;" 
                             FontSize="96"
                             Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                    <TextBlock x:Uid="WelcomeTitle"
                              Style="{StaticResource TitleTextBlockStyle}"
                              TextAlignment="Center"/>
                    <TextBlock x:Uid="WelcomeMessage"
                              Style="{StaticResource BodyTextBlockStyle}"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              TextWrapping="Wrap"
                              TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Tab View Container (hidden by default) -->
        <Grid Grid.Row="1" x:Name="TabViewContainer" Visibility="Collapsed">
            <!-- SplitView for Navigation Pane -->
            <SplitView x:Name="NavigationSplitView"
                      DisplayMode="Overlay"
                      IsPaneOpen="False"
                      OpenPaneLength="320"
                      PaneOpening="NavigationSplitView_PaneOpening"
                      PaneClosed="NavigationSplitView_PaneClosed"
                      SizeChanged="NavigationSplitView_SizeChanged">
                <SplitView.PaneBackground>
                    <media:AcrylicBrush xmlns:media="using:Microsoft.UI.Xaml.Media"
                                       TintColor="{ThemeResource SolidBackgroundFillColorBase}" 
                                       TintOpacity="0.5"
                                       TintLuminosityOpacity="0.8"
                                       FallbackColor="{ThemeResource SolidBackgroundFillColorBase}"/>
                </SplitView.PaneBackground>
                <SplitView.Pane>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Pane Header with close button -->
                        <Grid Grid.Row="0" Padding="16,12" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock x:Uid="ConnectionsTitle" 
                                         Style="{StaticResource SubtitleTextBlockStyle}"
                                         FontWeight="SemiBold"/>
                                <TextBlock x:Uid="ConnectionsSubtitle"
                                         Style="{StaticResource CaptionTextBlockStyle}"
                                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            
                            <!-- Close Pane Button -->
                            <Button Grid.Column="1"
                                   Click="ClosePaneButton_Click"
                                   Width="32" Height="32"
                                   Padding="0"
                                   Background="Transparent"
                                   BorderThickness="0"
                                   VerticalAlignment="Top">
                                <FontIcon Glyph="&#xE8BB;" FontSize="12"/>
                            </Button>
                        </Grid>
                        
                        <!-- Connections List -->
                        <ScrollViewer Grid.Row="1" Padding="8,8">
                            <StackPanel x:Name="ConnectionsListPanel" Spacing="4"/>
                        </ScrollViewer>
                        
                        <!-- New Connection Button -->
                        <Border Grid.Row="2" 
                               Padding="12"
                               Background="Transparent"
                               BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                               BorderThickness="0,1,0,0">
                            <Button x:Name="NewConnectionButtonNav"
                                   x:Uid="NewConnectionButton"
                                   Click="NewConnectionButtonNav_Click"
                                   HorizontalAlignment="Stretch"
                                   Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="16"/>
                                    <TextBlock x:Uid="NewConnectionText"/>
                                </StackPanel>
                            </Button>
                        </Border>
                    </Grid>
                </SplitView.Pane>
                
                <!-- Content area for tabs -->
                <Grid x:Name="TabContentArea"/>
            </SplitView>
        </Grid>
    </Grid>
</Window>
